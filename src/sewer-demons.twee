:: StoryData
{
  "ifid": "ACC5DDEA-DC29-49EE-A59A-F017024FF738",
  "format": "SugarCube",
  "format-version": "2.37.3",
  "start": "CharacterCreation",
  "zoom": 1
}

:: StoryTitle
Sewer Demons


:: Story Stylesheet [stylesheet]
/* ---- dark sewer theme ---- */
body { background-color: #0a0c0a; }
#story { color: #b9c0b4; }
a.link-internal { color: #8fae7a; }
a.link-internal:hover { color: #cfe0b8; }

/* ---- visible corruption meter (lives in the left UI bar) ---- */
.corruption-block { margin: 1em 0; font-size: 0.85em; }
.corruption-label {
  text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8em;
  color: #7a857a; margin-bottom: 0.3em;
}
.corruption-bar {
  height: 10px; width: 100%; background-color: #1c211c;
  border: 1px solid #313a31; border-radius: 2px; overflow: hidden;
}
.corruption-fill { height: 100%; background-color: #8f2b2b; transition: width 0.6s ease, background-color 0.6s ease; }
.corruption-fill.t1 { background-color: #a33636; }
.corruption-fill.t2 { background-color: #6d2348; }
.corruption-num { margin-top: 0.3em; color: #6f786f; font-size: 0.8em; }
.body-state { margin-top: 0.5em; font-size: 0.78em; font-style: italic; color: #5d6b58; line-height: 1.3; }

/* ---- Restart note (owner 2026-07-01): the manual UI-bar Restart is the ONE deliberate
   fresh start — it wipes every cross-life mark. Every in-game ending ("Again") arms
   carryover instead (setup.restartCarry, see the StoryInit block), so the marks survive.
   Warn quietly ABOVE the button so the wipe is a choice, not a surprise. Targets the
   <li>::before so it won't clash with the <a>::before power icon SugarCube renders. ---- */
#menu-item-restart::before {
  content: "Wipes every past life. Reaching an ending and going again keeps your marks; this button alone clears them.";
  display: block;
  margin: 0.4em 0 0.55em;
  padding-top: 0.6em;
  border-top: 1px solid #2c322c;
  font-size: 0.72em;
  font-style: italic;
  line-height: 1.35;
  letter-spacing: 0.02em;
  color: #9a7a4a;   /* dim warning ochre, low-saturation — field-guide chrome */
  white-space: normal;
}

/* ---- per-segment body readout (field-guide monospace; the transformation centerpiece) ---- */
.bodymap { font-family: monospace; font-size: 0.78em; margin: 0.8em 0 0; border-top: 1px solid #1c211c; padding-top: 0.55em; }
.bodymap .bm-label { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.82em; color: #7a857a; margin-bottom: 0.35em; }
.bodymap .bm-row { display: flex; justify-content: space-between; gap: 0.5em; line-height: 1.5; color: #5d6b58; }
.bodymap .bm-seg { color: #7a857a; }
.bodymap .bm-row.s-tingle  { color: #8a8f6e; }
.bodymap .bm-row.s-tainted { color: #a89a52; }
.bodymap .bm-row.s-turning { color: #c07a3a; }
.bodymap .bm-row.s-turned  { color: #a33636; font-style: italic; }
.bodymap .bm-clean { color: #45503f; }
.bodymap .bm-intact { color: #5d6b58; font-style: italic; }
.bodymap .bm-desc { font-size: 0.72em; font-style: italic; line-height: 1.25; margin: 0.05em 0 0.35em 0.2em; color: #5d6b58; }
.bodymap .bm-desc.d-tingle  { color: #6f745b; }
.bodymap .bm-desc.d-tainted { color: #8a7e4a; }
.bodymap .bm-desc.d-turning { color: #9a6334; }
.bodymap .bm-desc.d-turned  { color: #8f4a4a; }

/* ---- transformation feed: the body-change beat shown at the top of a room, in the main
   column, the moment corruption lands (brighter than the side-bar readout — it's a stinger). ---- */
.change-feed { margin: 0 0 1.2em 0; padding: 0.15em 0 0.15em 0.85em; border-left: 2px solid #5a3236; }
.change-line { font-style: italic; line-height: 1.4; margin: 0.2em 0; color: #b39a9a; }
.change-line.cf-tingle  { color: #9ca07c; }
.change-line.cf-tainted { color: #c0a256; }
.change-line.cf-turning { color: #d0823e; }
.change-line.cf-turned  { color: #d65a5a; font-style: normal; font-weight: bold; }
.change-line.cf-deepen  { color: #8a8a72; }   /* a "works deeper" repeat beat — muted, never the loud turned styling */

/* ---- systemic regard: the world's standing read of the body you wear (ambient, the world's voice,
   distinct from the feed which is your body's). matched = a sickly ochre welcome (claimed); mismatched
   = a cold slate attention (marked wrong). ---- */
.regard-line { margin: 1.1em 0; padding: 0.15em 0 0.15em 0.85em; border-left: 2px solid #3a4a5a; font-style: italic; line-height: 1.45; }
.regard-line.r-matched    { border-left-color: #6a5a32; color: #b3a378; }
.regard-line.r-mismatched { border-left-color: #3f4a59; color: #8a93a0; }

/* ---- nose-blind: the one-time realization you've gone anosmic to what you're becoming. Not a change
   (feed) or a verdict (regard) but an ABSENCE — drained grey, set off by rules as a milestone band. ---- */
.nose-blind { margin: 1.3em 0; padding: 0.7em 0.9em; border-top: 1px solid #2c322c; border-bottom: 1px solid #2c322c; font-style: italic; line-height: 1.5; color: #74807a; }

/* ---- room-scent: how the place's stink hits you, and how your disgust erodes as you corrupt (revulsion
   is silent — the room prose owns it). A warm sensory band, distinct from regard (the world's cold/ochre
   voice) and the grey nose-blind absence. accept = the alarm gone quiet; relish = warmer, the body leaning in. ---- */
.room-scent { margin: 1.0em 0; padding: 0.15em 0 0.15em 0.85em; border-left: 2px solid #4a3a2a; font-style: italic; line-height: 1.45; color: #a8916f; }
.room-scent.rs-recoil { border-left-color: #54611f; color: #98a64a; }   /* the fresh recoil — a sour, nauseous green; the alarm, opposite the warm adaptation */
.room-scent.rs-accept { border-left-color: #5a4630; color: #a8916f; }
.room-scent.rs-relish { border-left-color: #7c4a28; color: #c4894f; }
.room-scent.rs-dread { border-left-color: #6e2b1e; color: #b35a3d; }    /* the threat-read's top rung (review R14) — rust-red, the body's flat NO; rungs 1-2 reuse the band default ("rs-even" matches no rule on purpose) */

/* ---- belonging / the settling mind (the seal clock read as comfort, not just the closing exit).
   .seal-state = the standing state, in the caption; .settle-line = the milestone beat in the main
   column. Violet-grey = the mind/psyche axis (kin to the mana violet), a cold quiet distinct from
   the warm room-scent and the world's slate regard. ---- */
.seal-state { margin-top: 0.55em; font-size: 0.78em; font-style: italic; color: #7a7488; line-height: 1.3; }
.settle-line { margin: 1.1em 0; padding: 0.15em 0 0.15em 0.85em; border-left: 2px solid #4a4258; font-style: italic; line-height: 1.45; color: #948aa0; }
.settle-line.settle-switch { border-left-color: #5a4a6a; color: #b09ec0; }   /* the un-settling jolt (form changed) — a brighter, colder violet than the warm settle */

/* ---- the mouth-misspeak curse indicator ---- */
.curse-line { margin: 0.7em 0 0; font-size: 0.8em; font-style: italic; color: #6d2348; line-height: 1.3; border-top: 1px solid #1c211c; padding-top: 0.55em; }

/* ---- kit / inventory readout ---- */
.kit { margin: 1em 0; font-size: 0.8em; color: #8a9486; line-height: 1.5; border-top: 1px solid #1c211c; padding-top: 0.6em; }
.kit .k-coins { color: #b59a4d; }
.kit .k-hurt { color: #a33636; }

/* ---- D&D-style character sheet (monospace, low-key — field-guide aesthetic) ---- */
.statsheet { font-family: monospace; font-size: 0.82em; margin-bottom: 0.6em; }
.statsheet .ss-lvl { text-transform: uppercase; letter-spacing: 0.1em; color: #7a857a; font-size: 0.85em; }
.statsheet .ss-lvl .ss-marked { color: #6d2348; }
.statsheet .ss-xp { color: #7a857a; font-size: 0.82em; letter-spacing: 0.04em; margin-top: 0.15em; }
.statsheet .ss-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.15em 0.5em; margin: 0.35em 0; color: #9aa494; }
.statsheet .ss-derived { color: #8fae7a; }
.statsheet .ss-mana { color: #b89ac8; font-size: 0.9em; margin-top: 0.1em; }
.statsheet .ss-mana .ss-mana-note { color: #6f5a82; font-size: 0.85em; }

/* ---- combat log ---- */
.clog { font-style: italic; color: #cfae7a; margin-bottom: 0.6em; }
.cbt-wind { font-size: 0.78em; color: #c9a35a; font-style: italic; letter-spacing: 0.04em; }

/* ---- room illustration (<<roomart>>) ---- */
.room-illus { margin: 0 0 1.1em; text-align: center; }
.room-illus-img { max-width: 100%; max-height: 24em; border: 1px solid #262d24; border-radius: 3px; display: inline-block; }

/* ---- room diorama (the sprite scene; see src/sprite-scene.twee) ----
   A lamp-lit patch of a much larger dark, which is what the prose has been saying all
   along — so the corners fall off rather than meeting a hard frame. Keep the vignette
   LIGHT: the imported art is painted for a daylit tactical map and is already dark
   against this page, and a heavy overlay turns the whole plate to mud (it did, first
   try). The canvas sizes itself in JS and is centred here, never stretched — scaling
   it in CSS would resample art that was just drawn at exactly the right size. */
.room-scene { position: relative; margin: 0 0 1.05em; line-height: 0; text-align: center; }
.room-scene canvas { display: inline-block; max-width: 100%; border: 1px solid #262d24; border-radius: 3px;
                     background: radial-gradient(ellipse 72% 80% at 50% 74%, #20261c 0%, #141810 58%, #0c0f0a 100%); }
.room-scene::after { content: ""; position: absolute; inset: 0; pointer-events: none;
                     background: radial-gradient(ellipse 82% 90% at 50% 72%, rgba(0,0,0,0) 62%, rgba(8,10,7,0.34) 100%); }

/* ---- combat screen (owner 2026-06-05): name, portrait, hp bars side by side, button row ---- */
.combat-screen { margin: 0.2em 0 0.4em; }
.combatants { display: flex; flex-wrap: wrap; gap: 0.7em; align-items: flex-start; margin-bottom: 0.7em; }
.cbt { flex: 1 1 7.5em; min-width: 6.8em; max-width: 12em; border: 1px solid #313a31; border-radius: 3px; padding: 0.5em; background: #11140f; }
.cbt.player { border-color: #3a4a31; }
.cbt.enemy.targeted { border-color: #a89a52; box-shadow: 0 0 0 1px #a89a52 inset; }
.cbt.dead { opacity: 0.4; }
.cbt.dead .cbt-name { text-decoration: line-through; }
.cbt-name { font-family: monospace; font-size: 0.85em; letter-spacing: 0.04em; color: #b9c0b4; margin-bottom: 0.35em; text-align: center; }
.cbt.player .cbt-name { color: #8fae7a; }
.portrait { position: relative; width: 100%; aspect-ratio: 2 / 3; margin-bottom: 0.4em; border: 1px solid #262d24; border-radius: 2px; background-color: #0c0f0a; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.portrait .port-glyph { font-size: 2.4em; opacity: 0.4; filter: grayscale(0.5); }
.portrait .port-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.portrait.player-port { background-color: #0e120c; }
.hpbar { height: 8px; background: #1c211c; border: 1px solid #313a31; border-radius: 2px; overflow: hidden; }
.hpfill { height: 100%; transition: width 0.4s ease; }
.hpfill.player { background: #6f9a4d; }
.hpfill.enemy { background: #8f2b2b; }
.hp-num { margin-top: 0.25em; font-size: 0.72em; color: #7a857a; font-family: monospace; text-align: center; }
.cbt .tgt-link { display: block; text-align: center; font-size: 0.72em; margin-top: 0.3em; }
.combat-actions { display: flex; flex-wrap: wrap; gap: 0.45em; margin-top: 0.4em; }
.combat-actions a.link-internal { display: inline-block; padding: 0.4em 0.85em; border: 1px solid #3a4a31; border-radius: 3px; background: #161a13; color: #9fc081; text-decoration: none; font-size: 0.92em; }
.combat-actions a.link-internal:hover { background: #1e241a; color: #cfe0b8; border-color: #5a7049; }
.combat-actions .act-spent { display: inline-block; padding: 0.4em 0.85em; border: 1px solid #262d24; border-radius: 3px; color: #5a6450; font-size: 0.92em; opacity: 0.5; }
.combat-actions.special-menu a.link-internal, .combat-actions.items-menu a.link-internal { border-color: #5a4a6a; color: #b89ac8; background: #15111a; }
.combat-actions.special-menu a.link-internal:hover, .combat-actions.items-menu a.link-internal:hover { color: #d9c2ea; border-color: #6f5a82; }
.special-hint { font-size: 0.78em; color: #7a857a; font-style: italic; margin: 0.1em 0 0.4em; }

/* ---- Equipment screen + gear ---- */
.equip-screen { max-width: 40em; }
.equip-head { font-size: 1.05em; color: #cdbf9a; border-bottom: 1px solid #2a3026; padding-bottom: 0.3em; margin-bottom: 0.4em; }
.equip-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.1em 0.8em; font-size: 0.85em; color: #9aa48f; margin-bottom: 0.8em; }
.equip-slot { border: 1px solid #242a20; border-radius: 4px; padding: 0.45em 0.6em; margin: 0.35em 0; background: #11140f; }
.es-name { font-size: 0.72em; letter-spacing: 0.08em; text-transform: uppercase; color: #6f7a64; }
.es-worn { color: #d6cba8; margin: 0.1em 0; }
.es-empty { color: #5a6450; font-style: italic; }
.es-bound { color: #b06a6a; font-size: 0.85em; }
.es-brief { color: #8a9079; font-size: 0.82em; }
.es-opts { margin-top: 0.25em; font-size: 0.9em; }
.es-opt { display: block; margin: 0.12em 0; }
.es-locked { color: #9a6a6a; font-style: italic; }
.equip-junk { margin-top: 0.6em; font-size: 0.82em; color: #6f7363; }
.equip-hint { margin-top: 0.6em; font-size: 0.8em; color: #7a857a; font-style: italic; }
.gear-link { margin-top: 0.5em; font-size: 0.85em; }

/* ---- In-game map screen (setup.mapView) ---- */
.map-screen-head { color: #cdbf9a; font-size: 0.95em; margin-bottom: 0.5em; }
.map-screen-head .map-sub { color: #7a857a; font-style: italic; font-size: 0.85em; display: block; }
.map-screen { border: 1px solid #242a20; border-radius: 6px; padding: 0.4em;
  background: radial-gradient(circle at 50% 38%, #15171b 0%, #0c0d0f 82%); }
.map-tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.4em; }
.map-tab { background: #16181c; color: #9aa1a8; border: 1px solid #2a2e34; border-radius: 4px;
  padding: 2px 9px; cursor: pointer; font: inherit; font-size: 0.8em; }
.map-tab:hover { border-color: #4a5159; color: #d6dade; }
.map-tab.active { background: #c9b86a; color: #0c0d0f; border-color: #c9b86a; font-weight: 700; }
.map-tab.locked { color: #3a4047; cursor: default; border-color: #1c1f24; }
.map-headline { display: flex; align-items: baseline; gap: 0.6em; margin: 0.1em 0 0.3em; flex-wrap: wrap; }
.map-title { color: #e4e7ea; font-weight: 700; font-size: 0.95em; }
.map-count { color: #6b727a; font-size: 0.8em; }
.map-band { font-size: 0.62em; text-transform: uppercase; letter-spacing: 0.1em; padding: 1px 6px; border-radius: 3px; }
.map-band.band-sewer { background: #2f3a2a; color: #9fc77f; }
.map-band.band-between { background: #3a2f1c; color: #e0b46a; }
.map-band.band-hell { background: #3a1f1c; color: #e08a6a; }
.map-svg { width: 100%; height: auto; display: block; }
.map-empty { color: #6b727a; font-style: italic; text-align: center; padding: 2em 0; }
.map-back { margin-top: 0.6em; }

/* ---- Shop stalls ---- */
.shop { margin: 0.5em 0; }
.shop-head { font-size: 0.72em; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a55; border-bottom: 1px solid #2a2a20; margin: 0.6em 0 0.25em; }
.shop-row { margin: 0.18em 0; }
.shop-have { color: #6f7363; font-style: italic; }
.shop-cant { color: #5f6656; }
.shop-coins { margin: 0.6em 0; font-size: 0.9em; color: #cdbf9a; }


:: StoryInit
/* ---- Game state (serialized into saves — DATA ONLY) ---- */
<<set $corruption to 0>>   /* DERIVED MIRROR of the six body segments (avg) — the "general
   corruption" meter. Kept in sync by setup (recomputeBody / corrupt / soothe) so every
   legacy read ($corruption gte N, the meter) keeps working. Do NOT write it directly in
   rooms anymore — use <<corrupt segment class amount>> / <<soothe amount>>. */
<<set $body to null>>      /* per-segment corruption (6 segments x {rat,pig,filth}); built in the <<run>> block below once setup.* exists */
<<set $form to null>>      /* what each segment has BECOME ("human" until its total hits 100, then its dominant class); resets each life */
<<set $pendingChanges to []>>  /* TRANSFORMATION FEED: queued body-change beats, flushed + cleared by PassageHeader so a <<corrupt>> inside a link surfaces its narration on the room you land in. Engine-owned; filled by the <<corrupt>> widget via setup.pushChange. */
<<set $regardCooldown to 0>>   /* SYSTEMIC REGARD: eligible-moves of grace after the world reads your body, so the ambient regard beat is a rule, not a nag (setup.REGARD_COOLDOWN). */
<<set $regardLast to "">>      /* the last regard verdict shown (relation:floor:body:tier); a change refreshes immediately, same verdict only after the cooldown. */
<<set $noseBlind to []>>       /* NOSE-BLIND milestone: classes you've gone anosmic to this life (olfactory adaptation — you stop smelling the thing you've become). One beat per class per life; resets each life via restart. */
<<set $scentCooldown to 0>>    /* ROOM-SCENT: eligible-moves of grace after the room's stink reads on you, so the ambient scent beat is a rule, not a nag (reuses setup.REGARD_COOLDOWN). */
<<set $scentLast to "">>       /* the last room-scent verdict shown (kind:tier); a change (new smell, or your reaction to it slid a rung) refreshes immediately, same verdict only after the cooldown. */
<<set $foundRealExit to false>>

/* labyrinth depth / the "belonging" clock (hell claims you over time) */
<<set $deepTurns to 0>>
<<set $sealed to false>>
<<set $sealNoticed to 0>>   /* highest belonging-tier the mind has already noticed settling into (0-3); one beat per escalation */
<<set $formLast to null>>  /* the dominant mutagen class the belonging clock is settling into; changing it (rat→pig) resets the clock */

/* inventory / equipment / combat */
<<set $coins to 0>>
<<set $level to 1>>      /* "skill level" — flat ability scores per level for now (boss) */
<<set $xp to 0>>         /* experience this life; drives level-ups (see setup.gainXP). Resets each life — marks are the cross-life track. */
<<set $scores to {}>>    /* six D&D ability scores; filled by setup.recomputePlayer() below */
<<set $statMods to {}>>  /* in-life acquired ability deltas (the gutter bones, future ordeals); folded into $scores by setup.playerScores; reset each life */
<<set $maxhp to 0>>      /* derived from level + CON in recomputePlayer() */
<<set $hp to null>>      /* null so recomputePlayer() heals a fresh life to full */
<<set $inventory to ["clothes"]>>   /* you came down in your own clothes — the default armour (owner 2026-06-06) */
<<set $weapon to null>>
<<set $armor to "clothes">>
/* accessory equip slots (DIRECTION-EQUIPMENT §C). Each holds one item id (kind
   "accessory") that carries a magic blessing or a curse via the modifier pipeline. */
<<set $ring to null>>
<<set $necklace to null>>
<<set $boots to null>>
<<set $gloves to null>>
/* graft slots (the Cutter's body-mods, L7 TheSurgery). Flesh, not gear: installed only by the
   Cutter at a corruption cost, permanent for the life, and NOT carried cross-life (a new body is
   reborn whole). Empty graft slots are hidden on the Equipment screen until one is filled. */
<<set $eye to null>>
<<set $hand to null>>
<<set $hide to null>>
<<set $heart to null>>
<<set $idKnown to []>>          /* item ids whose hidden magic/curse you've identified (hidden-until-equipped) */
<<set $gearReturn to "">>       /* the room the Equipment screen returns to */
<<set $enemies to []>>          /* multi-enemy combat: the party you face (owner 2026-06-05) */
<<set $target to 0>>            /* the aimed enemy index (Attack/single-target) */
<<set $specialUses to 0>>       /* specials fired this fight; max per fight = $level */
<<set $combatSpoils to { coins: 0, xp: 0 }>>  /* accrues as enemies fall; CombatVictory reads it */
<<set $combatMenu to "main">>   /* combat action menu: "main" / "special" / "items" / "cast" / "yield" */
<<set $yieldKind to "">>        /* PARLEY (review R16): which offer landed — "purse" / "shift"; CombatYielded branches on it */
<<set $yieldTook to 0>>         /* coins the pack took on an accepted purse-toss */
<<set $yieldRoom to "">>        /* where an accepted shift-offer marches you (set at offer time) */
<<set $blood to { rat: 0, pig: 0, filth: 0 }>>  /* THE BLOOD LEDGER (review R17): kills by class this life; tallied in CombatVictory, read as regard */
<<set $swOut to {}>>            /* SHORT-WEIGHTS (owner 2026-07-03): the last gambit's outcome, read by ShortWeightDone */
<<set $swStat to "">>          /* ...and which dump stat it tested (picks the face's prose) */
<<set $encounterReturn to "">>  /* where a random encounter interrupted you; resolution returns here */
<<set $encounterFight to false>>  /* this fight is a RESISTED random encounter (CombatLost adds a 50% work roll) */
<<set $combatReturn to "Hellmouth">>
<<set $combatOrigin to "Hellmouth">>   /* the room a fight was started in; flee/loss return here (victory uses $combatReturn) */
<<set $combatLog to "">>
<<set $gritRatCleared to false>>

/* MAGIC — the Word (owner-goal 2026-06-18). $magicKnown gates everything; mana ceiling = magic
   level + corruption (setup.recomputeMana). Learned once, from a character/item/location. */
<<set $magicKnown to false>>
<<set $mana to 0>>
<<set $maxmana to 0>>
<<set $magicSource to "">>
<<set $heardOfWord to false>>   /* heard the Hellmouth arch can be READ (from the newly-taken) — ungates the location-learn */
<<set $heardOfGrimoire to false>>  /* overheard the midway demons gossip about the privy roll — ungates the item-learn's recognition */
<<set $flyTipped to false>>     /* bought the Hellmouth Inn barkeep (the Fly on the Wall) a round + tip — unlocks his gossip (TheFlyOnTheWall) */

/* map / meta-puzzle / L2 room state */
<<set $sigil to []>>            /* sigil-fragment ids collected across hell layers */
<<set $valveClosed to false>>  /* L2 gate: drains TheBlackValve when closed */
<<set $fatbergBurned to false>> /* L2→L1 fire gate: the Fatberg, burned open with the brand from the Sulphur Deep's burning tree */
<<set $screeningGolemCleared to false>> /* L2 TheScreeningHall: the sewage demon (shit-golem) scattered */
